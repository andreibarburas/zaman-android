<?xml version="1.0" encoding="utf-8"?>
<!-- Widget event-row background: same "glass card" look as the in-app agenda rows
     (TodayScreen's AgendaRow — translucent fill + a faint 1dp outline), baked into a static
     shape drawable rather than a runtime border() modifier, since Glance's RemoteViews content
     can't rely on Compose-style border() being available/behaving the same across versions. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#14FFFFFF" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
